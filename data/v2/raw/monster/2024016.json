          "skill_name": "滋养之力",
          "skill_desc": "我方单位消灭【<u>建木枝梢</u>】后，获得1层【滋养之力】，造成的伤害提高。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
