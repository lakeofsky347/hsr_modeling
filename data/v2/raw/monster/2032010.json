        {
          "id": 203201001,
          "skill_name": "厮杀",
          "skill_desc": "对指定我方单体目标及其相邻目标造成少量物理属性伤害，若自身处于【<u>月狂</u>】状态，则大概率为目标附上【裂伤】。",
          "damage_type": "Physical",
          "sp_hit_base": 10,
          "extra": {
            "220320102": {
              "name": "月狂",
              "desc": "此状态下，玄爪狼卒的速度提高，且攻击时大概率为目标附上【裂伤】，玄爪狼卒被弱点击破时解除此状态。",
              "param": []
            }
          }
        },
        {
          "id": 203201002,
          "skill_name": "狼吞",
          "skill_desc": "当敌方施放攻击后，为<u>能够进入【月狂】状态的敌方单位</u>附加1层【<u>嗜血</u>】，当【<u>嗜血</u>】达到指定层数时，将使其进入【<u>月狂</u>】状态。\\n行动序列上出现【月狂】倒计时，倒计时回合开始时所有敌方单位解除【<u>月狂</u>】状态。",
          "damage_type": "Physical",
          "sp_hit_base": "",
          "extra": {
            "220320101": {
              "name": "能够进入【月狂】状态的敌方单位",
              "desc": "能够进入【月狂】状态的敌方单位：玄爪狼卒、 蚀月狼卒、咆哮灵柩、咆哮灵柩（错误）、步离战首•呼雷、步离战首•呼雷（完整）。",
              "param": []
            },
            "220320103": {
              "name": "嗜血",
              "desc": "所有能够进入【月狂】的敌方单位共享【嗜血】层数。当有能够进入【月狂】的敌方单位进入战斗时，将附加相同层数的【嗜血】。回合结束时，若场上所有能够进入【月狂】的敌方单位均被击败，清除所有【嗜血】层数。",
              "param": []
            },
            "220320102": {
              "name": "月狂",
              "desc": "此状态下，玄爪狼卒的速度提高，且攻击时大概率为目标附上【裂伤】，玄爪狼卒被弱点击破时解除此状态。",
              "param": []
            }
          }
        }
      ]
    },
