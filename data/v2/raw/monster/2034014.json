          "sp_hit_base": 15,
          "extra": {}
        },
        {
          "id": 203401406,
          "skill_name": "血鸣狂噬",
          "skill_desc": "呼雷在进入【噬月】状态前，韧性无法被削减，当敌方施放攻击后，为<u>能够进入【噬月】状态的敌方单位</u>附加1层【<u>嗜血</u>】，当【<u>嗜血</u>】达到指定层时，呼雷将进入【<u>噬月</u>】状态，并施放【孤战】。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "220340142": {
              "name": "能够进入【噬月】状态的敌方单位",
              "desc": "能够进入【噬月】状态的敌方单位：玄爪狼卒、 蚀月狼卒、雷奔云谲的恶狼主。",
              "param": []
            },
            "220340143": {
              "name": "嗜血",
              "desc": "所有能够进入【噬月】的敌方单位共享【嗜血】层数。当有能够进入【噬月】的敌方单位进入战斗时，将附加相同层数的【嗜血】。回合结束时，若场上所有能够进入【噬月】的敌方单位均被击败，清除所有【嗜血】层数。",
              "param": []
            },
            "70000317": {
              "name": "噬月",
              "desc": "此状态下，首领幻影会施放【孤战】，我方需要选择1名角色与首领幻影进行【孤战】，【孤战】期间除被选择的角色及其召唤的目标外，其他我方目标处于离场状态。首领幻影被弱点击破时解除此状态。",
              "param": []
            }
          }
        },
        {
          "id": 203401407,
          "skill_name": "狼啸八方",
          "skill_desc": "当呼雷进入【<u>噬月</u>】状态时，受到的伤害降低，韧性可以被削减，并为自身添加【怒意】。【怒意】拥有初始层数，且每当敌方回合结束时，将减少1层【怒意】。每当【怒意】减少至0层时，将退出【噬月】状态。",
          "damage_type": "",
          "sp_hit_base": 10,
          "extra": {
            "70000317": {
              "name": "噬月",
              "desc": "此状态下，首领幻影会施放【孤战】，我方需要选择1名角色与首领幻影进行【孤战】，【孤战】期间除被选择的角色及其召唤的目标外，其他我方目标处于离场状态。首领幻影被弱点击破时解除此状态。",
              "param": []
            }
          }
        },
        {
          "id": 203401408,
          "skill_name": "狼群敕令，唤雷奔袭",
          "skill_desc": "每当我方对其他敌方目标造成致命攻击时，会对呼雷造成伤害并削减韧性，为我方全体角色添加【<u>血涌</u>】，为<u>能够进入【噬月】状态的敌方单位</u>附加1层【<u>嗜血</u>】，并召唤【玄爪狼卒】或【蚀月狼卒】。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "220340141": {
              "name": "血涌",
              "desc": "拥有【血涌】的我方角色及其召唤的目标进入【孤战】时，攻击后会额外削减韧性，并恢复生命值，此效果可叠加，并在【孤战】结束时移除。",
              "param": []
            },
            "220340143": {
              "name": "嗜血",
              "desc": "所有能够进入【噬月】的敌方单位共享【嗜血】层数。当有能够进入【噬月】的敌方单位进入战斗时，将附加相同层数的【嗜血】。回合结束时，若场上所有能够进入【噬月】的敌方单位均被击败，清除所有【嗜血】层数。",
              "param": []
            }
          }
        },
        {
          "id": 203401409,
          "skill_name": "孤战",
          "skill_desc": "进入【孤战】状态，呼雷造成的伤害增加，我方可选择1名角色及其召唤的目标进入【孤战】状态，选择后对指定我方单体造成雷属性伤害，且直到【怒意】耗尽前其他我方和敌方目标<u>离场</u>。我方目标进入【孤战】状态后，将使我方恢复战技点，根据我方全体角色当前的生命值上限和攻击力提高自身的生命值上限和攻击力，且【<u>血涌</u>】将生效，并根据【<u>血涌</u>】层数为自身添加【<u>战血激昂</u>】。我方全体角色所持有的【<u>血涌</u>】将在【孤战】状态结束后移除。",
          "damage_type": "Thunder",
          "sp_hit_base": "",
          "extra": {
            "10000016": {
              "name": "离场",
              "desc": "处于离场状态的目标无法成为技能目标，且不会出现在行动序列上。",
              "param": []
            },
            "220340141": {
              "name": "血涌",
              "desc": "拥有【血涌】的我方角色及其召唤的目标进入【孤战】时，攻击后会额外削减韧性，并恢复生命值，此效果可叠加，并在【孤战】结束时移除。",
              "param": []
            },
            "220340144": {
              "name": "战血激昂",
              "desc": "造成的伤害提高，击破特攻提高，此效果可叠加。",
              "param": []
            }
          }
        },
