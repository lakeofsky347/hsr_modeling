          }
        },
        {
          "id": 203501203,
          "skill_name": "束身天除",
          "skill_desc": "强化自身获得额外行动。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 203501204,
          "skill_name": "风胄雷鞮",
          "skill_desc": "与蚀月心兽的所有部位产生共鸣，并解除其弱点击破状态，下次行动前无法被攻击并在下次行动对我方全体施放【席卷乾圜，气吞坤矩】。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 203501205,
          "skill_name": "席卷乾圜，气吞坤矩",
          "skill_desc": "对我方全体造成大量风属性伤害并根据剩余未被弱点击破的部位进行强化，每有1个未被击破的部位会使该技能的伤害提高，同时会附带对应部位的强化效果。",
          "damage_type": "Wind",
          "sp_hit_base": 20,
          "extra": {}
        },
        {
          "id": 203501206,
          "skill_name": "蚀心厉咒",
          "skill_desc": "我方可选择1名角色，随后对选定的我方角色造成风属性伤害并使其陷入【厉咒】状态，【厉咒】状态下的我方角色及其召唤物<u>离场</u>。同时召唤【浴血人狼】，代替该离场角色继续战斗，【浴血人狼】视为我方角色。",
          "damage_type": "Wind",
          "sp_hit_base": 10,
          "extra": {
            "10000016": {
              "name": "离场",
              "desc": "处于离场状态的目标无法成为技能目标，且不会出现在行动序列上。",
              "param": []
            }
          }
        },
        {
          "id": 203501207,
          "skill_name": "心念合一",
          "skill_desc": "【业火焚心的影将军】的额外行动会与【蛊言妄念的蚀心兽】的部位共鸣，共鸣会使【蛊言妄念的蚀心兽】的部位解除弱点击破状态；下次行动变为强化行动，【喰云之首】共鸣大概率使我方全体目标陷入<u>怒噪</u>状态，【裂维之爪】共鸣额外大幅增加伤害，【辟尘之尾】共鸣大概率使我方全体目标陷入<u>虚弱</u>状态。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "220350101": {
              "name": "怒噪",
              "desc": "无法操控，自动攻击随机敌方目标。若该目标被施放技能解除负面效果，将会优先被解除【怒噪】状态。",
              "param": []
            },
            "220350102": {
              "name": "虚弱",
              "desc": "造成的伤害降低。",
              "param": []
            }
          }
        },
