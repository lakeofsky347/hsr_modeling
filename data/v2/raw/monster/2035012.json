        },
        {
          "id": 203501202,
          "skill_name": "巨钺•铁爪",
          "skill_desc": "对指定我方单体目标造成风属性伤害，并大概率使受到攻击的我方目标陷入<u>虚弱</u>状态。",
          "damage_type": "Wind",
          "sp_hit_base": 10,
