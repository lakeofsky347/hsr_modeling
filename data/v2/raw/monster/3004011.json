      "skill_list": [
        {
          "id": 300401101,
          "skill_name": "律中，成为一身",
          "skill_desc": "本次战斗中，「昔在、今在、永在的剧目」与所有「秩序的傀儡」共享血量。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 300401102,
          "skill_name": "律起，神恩独作",
          "skill_desc": "进入战斗时，选择一名「秩序的傀儡」成为【司律】，每回合可再次行动，并小幅提高其速度。当目标的弱点被击破时，使其行动延后，并重新选择一名「秩序的傀儡」成为【司律】；如果此时所有「秩序的傀儡」都处于弱点击破状态，则会对自身造成伤害、额外延后所有「秩序的傀儡」的行动，并使其受到的伤害提高。当任意一名「秩序的傀儡」从弱点击破状态恢复时，会重新被选为【司律】。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 300401103,
          "skill_name": "律落，天民和鸣",
          "skill_desc": "使所有「秩序的傀儡」均成为【司律】并进入【守备】状态，每回合可再次行动并小幅提高其速度。当目标的弱点被击破时，使其行动延后；如果此时所有「秩序的傀儡」都处于弱点击破状态，则会对自身造成伤害、额外延后所有「秩序的傀儡」的行动，并使其受到的伤害提高。当「秩序的傀儡」从弱点击破状态恢复时，会重新被选为【司律】。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 300401104,
          "skill_name": "律成，领受诫命",
          "skill_desc": "在行动序列上添加【宣诫】，每次【宣诫】行动时，解除场上所有「秩序的傀儡」的控制类负面状态与弱点击破状态，并释放【为同一律献舞】。每当有一名「秩序的傀儡」的弱点被击破时，【宣诫】的行动将小幅延后。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 300401105,
          "skill_name": "律合，生生不息",
          "skill_desc": "在行动序列上添加一次【宣诫】。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 300401106,
          "skill_name": "为同一律献舞",
          "skill_desc": "大概率使我方全体陷入【<u>荒宴醉</u>】或【<u>欢宴罪</u>】状态，大概率使我方全体陷入【<u>异梦</u>】状态，并对我方全体造成大量物理属性伤害。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "23003051": {
              "name": "荒宴醉",
              "desc": "一定回合内，每回合开始时受到风属性伤害，该效果可叠加。",
              "param": []
            },
            "23003052": {
              "name": "欢宴罪",
              "desc": "一定回合内，每回合开始时受到雷属性伤害，该效果可叠加。",
              "param": []
            },
            "23025011": {
              "name": "异梦",
              "desc": "一定回合内无法行动，且每回合开始时回复少量生命值。受到攻击时大幅提高受到的伤害，受到攻击后解除【异梦】状态。",
              "param": []
            }
          }
        }
      ]
