          "extra": {}
        },
        {
          "id": 401401209,
          "skill_name": "不磨不灭的灾厄",
          "skill_desc": "对我方全体目标造成虚数属性伤害并施加<u>【荣耀】</u>，同时使自身获得【泰坦神躯】。【泰坦神躯】层数减少为0时行动延后，对自身造成大量虚数属性伤害，并为我方全体恢复能量。持有【泰坦神躯】会使下次攻击造成的伤害大幅提高并大概率使所有攻击到的目标陷入禁锢状态。",
          "damage_type": "Imaginary",
          "sp_hit_base": 5,
          "extra": {
            "240140101": {
              "name": "荣耀",
              "desc": "每层【荣耀】使伤害提高，能量恢复效率提高，使用战技或终结技时增加1层【荣耀】。攻击时可解除对应【荣耀】层数的【泰坦神躯】。",
              "param": []
            }
          }
        },
        {
          "id": 401401210,
          "skill_name": "千邦荡平，万军成灰",
          "skill_desc": "对我方全体造成大量虚数属性伤害，伤害由目标<u>平均分摊</u>。",
          "damage_type": "Imaginary",
          "sp_hit_base": 15,
          "extra": {
            "401301001": {
              "name": "平均分摊",
              "desc": "本次攻击结算前的伤害和负面效果由所有受击目标平均承受。",
              "param": []
            }
          }
        },
        {
          "id": 401401211,
          "skill_name": "城邦守护者",
          "skill_desc": "拥有一定层数的【战甲】，使自身受到的伤害降低。受到攻击后减少自身1层【战甲】，减少到0层时，【战甲】被破坏，对自身造成大量虚数属性伤害，并使自身行动延后，使破坏【战甲】的我方单位恢复能量。【战甲】被破坏后，自身受到攻击时额外再受到少量虚数属性伤害。【战甲】在自身回合结束时恢复到最大层数。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 401401212,
          "skill_name": "宁战死，毋荣归",
          "skill_desc": "施放【不磨不灭的灾厄】时为我方全体目标施加<u>【荣耀】</u>，每层<u>【荣耀】</u>提高目标造成的伤害和能量恢复效率，施放战技或终结技时可叠加<u>【荣耀】</u>；【蛮神，疯王，纷争的化身】下次行动后解除所有我方目标的<u>【荣耀】</u>状态。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "240140101": {
              "name": "荣耀",
              "desc": "每层【荣耀】使伤害提高，能量恢复效率提高，使用战技或终结技时增加1层【荣耀】。攻击时可解除对应【荣耀】层数的【泰坦神躯】。",
