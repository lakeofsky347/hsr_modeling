        {
          "id": 401502005,
          "skill_name": "遗骨",
          "skill_desc": "本次战斗中，对【枯槁的筛骨】或【干涸的泪骨】造成伤害时，【绝灭者，阳雷的业果，晨昏之眼】也会损失相等的生命值。当【枯槁的筛骨】或【干涸的泪骨】受到致命攻击时，【绝灭者，阳雷的业果，晨昏之眼】会受到韧性伤害，且【枯槁的筛骨】或【干涸的泪骨】回复生命值并进入不可被选中状态。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 401502006,
          "skill_name": "黑潮",
          "skill_desc": "在行动序列上添加【黑潮】，每次【黑潮】行动时，将使我方全体目标陷入【<u>腐化</u>】，【<u>腐化</u>】数值可叠加。当我方角色受到致命伤害时，将陷入【<u>黑蚀</u>】状态；当我方全体目标陷入【<u>黑蚀</u>】状态或无法战斗状态时，战斗失败。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "240150201": {
              "name": "黑蚀",
              "desc": "处于【黑蚀】状态下的目标无法被选中，无法行动。",
              "param": []
            },
            "240150202": {
              "name": "腐化",
              "desc": "可回复的生命上限降低。",
              "param": []
            }
          }
        },
        {
          "id": 401502007,
          "skill_name": "至暗潮汐",
          "skill_desc": "本场战斗中，【绝灭者，阳雷的业果，晨昏之眼】造成的所有伤害会基于【黑潮同步率】造成固定数值伤害，我方目标攻击后，会再基于【黑潮同步率】造成<u>真实伤害</u>，该伤害<u>【不致命】</u>。当【绝灭者，阳雷的业果，晨昏之眼】和【黑潮】行动时，将增加【黑潮同步率】，当【枯槁的筛骨】或【干涸的泪骨】被击杀时，会减少【黑潮同步率】。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "10000017": {
              "name": "真实伤害",
              "desc": "不受任何效果所影响的无属性伤害，本次伤害不视为造成了1次攻击。",
              "param": []
            },
            "401403001": {
              "name": "不致命",
              "desc": "目标受到伤害时，若目标生命值不足，则会将生命值降低至1点。",
              "param": []
            }
          }
