      "skill_list": [
        {
          "id": 403202301,
          "skill_name": "共祭•亡死的黑云",
          "skill_desc": "对指定我方单体及其相邻目标造成少量物理属性伤害。",
          "damage_type": "",
          "sp_hit_base": 5,
          "extra": {}
        },
        {
          "id": 403202302,
          "skill_name": "共祭•将尽的命数",
          "skill_desc": "对我方全体造成少量物理属性伤害，被击中目标降低生命值的一部分转化为<u>【侵蚀】</u>。",
          "damage_type": "",
          "sp_hit_base": 5,
          "extra": {
            "240320101": {
              "name": "侵蚀",
              "desc": "攻击后回复侵蚀部分的生命值，击中的目标数量越多，回复的生命值越高。受到伤害时，降低生命值的一部分转化为侵蚀。消耗生命值时，降低的生命值会全部转化为侵蚀。通过回复生命值的方式解除侵蚀时，使自身获得【焕新】效果。【焕新】：下次攻击造成的伤害提高。",
              "param": []
            }
          }
        },
        {
          "id": 403202303,
          "skill_name": "为我祷咏",
          "skill_desc": "抵抗控制类负面状态。当【黑斗篷魔王】再次施放【亡死的黑云】或【将尽的命数】时，若自身曾被该攻击召唤且处于【共祭】状态，则与【黑斗篷魔王】一同发起攻击。随后被其吸收，回复转化为<u>【苦痛缠绕】</u>的生命值，并使其获得<u>【灾难之力】</u>。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "403401001": {
              "name": "灾难之力",
              "desc": "施放特定技能时，消耗【灾难之力】的所有层数追加攻击段数。",
              "param": []
            },
            "70000215": {
              "name": "苦痛缠绕",
              "desc": "吸收【魔王爪牙】后回复召唤该【魔王爪牙】时消耗的生命值，【魔王爪牙】被消灭后，无法再回复召唤该【魔王爪牙】时消耗的生命值。",
              "param": []
            }
          }
        },
        {
          "id": 403202304,
          "skill_name": "为我设奠",
          "skill_desc": "处于【镣锁】状态下受到致命攻击，若【黑斗篷魔王】的<u>【灾难之力】</u>层数不为0，立即被其重新召唤并进入【镣锁】状态，但会使【黑斗篷魔王】失去1层<u>【灾难之力】</u>和一定比例的生命值。【黑斗篷魔王】施放【莫因舍弃而哭泣】时，被其吸收，回复转化为<u>【苦痛缠绕】</u>的生命值。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "403401001": {
              "name": "灾难之力",
              "desc": "施放特定技能时，消耗【灾难之力】的所有层数追加攻击段数。",
              "param": []
            },
            "70000215": {
              "name": "苦痛缠绕",
              "desc": "吸收【魔王爪牙】后回复召唤该【魔王爪牙】时消耗的生命值，【魔王爪牙】被消灭后，无法再回复召唤该【魔王爪牙】时消耗的生命值。",
              "param": []
            }
          }
        }
      ]
