          "skill_name": "黑光透射",
          "skill_desc": "对全体我方单位造成风属性伤害，被击中目标降低生命值的一部分转化为<u>【侵蚀】</u>。",
          "damage_type": "Wind",
          "sp_hit_base": 10,
          "extra": {
            "240320101": {
              "name": "侵蚀",
              "desc": "攻击后回复侵蚀部分的生命值，击中的目标数量越多，回复的生命值越高。受到伤害时，降低生命值的一部分转化为侵蚀。消耗生命值时，降低的生命值会全部转化为侵蚀。通过回复生命值的方式解除侵蚀时，使自身获得【焕新】效果。【焕新】：下次攻击造成的伤害提高。",
              "param": []
            }
          }
        },
        {
          "id": 403303002,
          "skill_name": "永夜颁示",
          "skill_desc": "召唤【黑日弓手】，【黑日弓手】被消灭时，会使自身损失部分生命值。【黑日弓手】不会主动行动，自身施放攻击后，所召唤的【黑日弓手】会施放一次攻击。",
          "damage_type": "",
