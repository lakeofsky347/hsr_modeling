          "id": 405201201,
          "skill_name": "海的裙摆飘荡",
          "skill_desc": "对我方全体造成少量冰属性伤害，处于【<u>在毁灭中狂欢</u>】状态时，对受到攻击的我方目标施加【<u>黑潮热</u>】，使造成的部分伤害以持续伤害形式在一定回合内扣除。",
          "damage_type": "Ice",
          "sp_hit_base": 10,
          "extra": {
            "405301001": {
              "name": "在毁灭中狂欢",
              "desc": "触发行动提前的受击次数降低，受到伤害或施放特定技能造成伤害时，使部分伤害以【黑潮热】形式在一定回合内扣除。【在毁灭中狂欢】倒计时回合开始时所有敌方单位解除【在毁灭中狂欢】状态。",
              "param": []
            },
            "405301002": {
              "name": "黑潮热",
              "desc": "【黑潮热】属于持续伤害类负面状态，持续伤害来源于目标受到伤害的一部分，叠加时刷新【黑潮热】的持续回合。【黑潮热】状态下，目标每回合开始时受到风化、灼烧、触电、裂伤持续伤害。敌方的【黑潮热】状态在【在毁灭中狂欢】状态结束时立即解除，我方的【黑潮热】状态在自身生命值回复到上限时立即解除，免受该持续伤害。",
              "param": []
            }
