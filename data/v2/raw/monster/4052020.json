          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 405202004,
          "skill_name": "请泊舟暂歇",
          "skill_desc": "受到一定次数的普攻、战技、终结技或忆灵技攻击后行动提前，处于【<u>在毁灭中狂欢</u>】状态时，触发行动提前的受击次数降低。",
