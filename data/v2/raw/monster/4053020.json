          "id": 405302003,
          "skill_name": "风雨雷的妊娠",
          "skill_desc": "在行动序列上添加【孵化】，并为自身附加【<u>孵育狂潮</u>】。【孵化】行动时会施放【洪潮浪的分娩】。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "240530201": {
              "name": "孵育狂潮",
              "desc": "此状态下，【飓风大母】受到攻击时受到的伤害降低。自身由于【请泊舟暂歇】提前行动时，将会消耗生命值，召唤【泡影稚子】，并使【孵化】行动小幅延后。",
              "param": []
            }
          }
        },
        {
          "id": 405302004,
          "skill_name": "雨自初生便落坠",
          "skill_desc": "对我方全体目标造成量子属性伤害。",
          "damage_type": "Quantum",
          "sp_hit_base": 10,
          "extra": {}
        },
        {
          "id": 405302005,
          "skill_name": "洪潮浪的分娩",
          "skill_desc": "召唤【泡影稚子】，并为其附加【风眼巢】。若此时场上存在【泡影稚子】，【飓风大母】将一直施放【雨自初生便落坠】，直到所有【泡影稚子】被消灭。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 405302006,
          "skill_name": "请泊舟暂歇",
          "skill_desc": "受到一定次数的普攻、战技、终结技或忆灵技攻击后行动提前，处于【<u>在毁灭中狂欢</u>】状态时，触发行动提前的受击次数降低。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "405301001": {
              "name": "在毁灭中狂欢",
              "desc": "触发行动提前的受击次数降低，受到伤害或施放特定技能造成伤害时，使部分伤害以【黑潮热】形式在一定回合内扣除。【在毁灭中狂欢】倒计时回合开始时所有敌方单位解除【在毁灭中狂欢】状态。",
              "param": []
            }
          }
        }
