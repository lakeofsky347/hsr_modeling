          "damage_type": "Quantum",
          "sp_hit_base": 10,
          "extra": {
            "501402001": {
              "name": "劳动最快乐！",
              "desc": "施放普攻后触发【锃亮】效果，对攻击目标额外造成真实伤害并获得笑点；施放战技后触发【洁净】效果，恢复战技点。该效果在【劳动最快乐！】效果持续时间内最多触发1次。",
              "param": []
