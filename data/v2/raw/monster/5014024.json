        {
          "id": 501402408,
          "skill_name": "洗地机之乱",
          "skill_desc": "每个阶段开始时【会场秩序维持】会为敌我双方召唤增援。我方每获得1个笑点时我方的「合金保姆」积累1点充能值，充能值达到<unbreak>#1[i]</unbreak>时可施放强化普攻移除1层【含辛茹苦的列车长】的【长效抗菌】效果，并可无视【弱点无效】效果强制削减韧性。我方的「合金保姆」最多存在1个，且不会被敌我双方选中。",
          "damage_type": "Quantum",
          "sp_hit_base": "",
          "extra": {
            "10000027": {
              "name": "笑点",
              "desc": "笑点为全队共享。造成欢愉伤害时，计入的笑点越多，欢愉伤害越高。",
              "param": []
            }
          }
        },
        {
          "id": 501402409,
          "skill_name": "创新漂白液",
          "skill_desc": "【破晓战队】处于【破晓力场】状态时，【含辛茹苦的列车长】会获得与该名【破晓战队】成员同属性的【伤害免疫】效果，同时获得【弱点无效】效果。任意【破晓战队】成员被我方目标消灭时，我方「合金保姆」立即获得1个可施放强化普攻的额外回合。",
          "damage_type": "Quantum",
