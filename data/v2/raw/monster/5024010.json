        {
          "id": 502401003,
          "skill_name": "凶梦汲取",
          "skill_desc": "吸取所有带有<u>【幸福】</u>或<u>【幸福傀儡】</u>效果我方目标的生命值并转化为自身生命值。",
          "damage_type": "Thunder",
          "sp_hit_base": 10,
          "extra": {
            "502401001": {
              "name": "幸福",
              "desc": "回合开始时增加层数，并在敌方召唤【邪愿莲华】，攻击敌方目标后减少1层，消灭1个敌方目标后额外减少1层；回合结束时若大于等于一定层数则被转化为【幸福傀儡】；变为0层时则解除该状态并添加【颠倒离断】效果。",
              "param": []
            },
            "502401002": {
              "name": "幸福傀儡",
              "desc": "无法行动，回合开始时随机陷入【怒噪】或【支配】状态并获得笑点，有概率造成【会心一击】使我方获得更多笑点。",
              "param": []
            }
          }
        },
