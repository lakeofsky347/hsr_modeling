          "skill_name": "集群连带应激",
          "skill_desc": "仪式中受到攻击会使【狂兽的胚芽】行动提前，且【堕神之血】不受行动提前效果的影响。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 503401006,
          "skill_name": "兽瞳百相",
          "skill_desc": "每次行动后增加1个「贪饕之眼」，回合结束时「贪饕之眼」达到一定数量则立刻施放【万物于我之中】。获得【血脑屏障】时速度大幅提高。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        },
        {
          "id": 503401007,
          "skill_name": "胎儿之梦",
          "skill_desc": "在行动序列上添加【破胞分生】，每次【破胞分生】行动时召唤【狂兽的胚芽】。【堕神之血】在场时，【狂兽的胚芽】的攻击会额外附加<u>【堕神衰腐】</u>和<u>【源质吞噬】</u>，【狂兽的胚芽】被击杀后会使【堕神之血】的生命值降低。受到攻击后会使【狂兽的胚芽】锁定发起攻击的角色。当我方全体角色陷入【幻身】状态时，战斗失败。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {
            "503401001": {
              "name": "堕神衰腐",
              "desc": "每次施放技能后减少1层，当到达一定层数后角色陷入【幻身】状态，持续时间结束或受到致命攻击时解除【幻身】状态。【幻身】状态下的我方角色及其召唤物<u>离场</u>，同时召唤【狂兽的胚芽】代替该离场角色继续战斗，【狂兽的胚芽】视为我方角色。",
              "param": []
            },
            "503401002": {
              "name": "源质吞噬",
              "desc": "可回复的生命上限降低，该效果可叠加。",
              "param": []
            },
            "10000016": {
              "name": "离场",
              "desc": "处于离场状态的目标无法成为技能目标，且不会出现在行动序列上。",
              "param": []
            }
          }
        },
        {
          "id": 503401008,
          "skill_name": "血脑屏障",
          "skill_desc": "当生命值降低到一定值时使自身获得【血脑屏障】，韧性无法被削减，并使自身受到所有伤害大幅降低，欢愉伤害破除【血脑屏障】的效率大幅提高。获得【血脑屏障】时，在行动序列上添加【稳态失衡】，击杀【狂兽的胚芽】可以增加【稳态失衡】的充能值，【稳态失衡】行动时根据获得的充能值对【血脑屏障】造成伤害。【血脑屏障】解除时自身受到大量伤害。",
          "damage_type": "",
          "sp_hit_base": "",
          "extra": {}
        }
      ]
